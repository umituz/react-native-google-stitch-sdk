{
  "name": "@umituz/react-native-google-stitch-sdk",
  "version": "1.0.6",
  "description": "React Native wrapper for Google Labs Stitch SDK with TypeScript support",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/domains/core/index.ts",
    "./init": "./src/init/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "version:patch": "npm version patch -m 'chore: release v%s'",
    "version:minor": "npm version minor -m 'chore: release v%s'",
    "version:major": "npm version major -m 'chore: release v%s'"
  },
  "keywords": [
    "react-native",
    "google",
    "stitch",
    "sdk",
    "typescript"
  ],
  "author": "umituz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/umituz/react-native-google-stitch-sdk.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@google/stitch-sdk": "^0.0.3"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-native": ">=0.74.0"
  },
  "devDependencies": {
    "@eslint/compat": "^1.3.2",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.35.0",
    "@types/react": "^19.1.12",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.0.0",
    "react": "19.2.0",
    "react-native": "0.83.2",
    "typescript": "^5.9.2"
  },
  "files": [
    "src",
    "skills",
    "README.md",
    "LICENSE"
  ]
}
